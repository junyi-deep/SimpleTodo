  "components": [
    {
      "name": "主按钮",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "用于提交与确认，单色反转填色。",
      "html": "<button class=\"ds-primary\">保存更改</button>",
      "css": ".ds-primary{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;font-size:12px;font-weight:500;min-height:32px;padding:6px 12px;border:1px solid var(--border);border-radius:var(--radius-control);background:var(--surface);color:var(--text);cursor:pointer;transition:background-color 140ms ease,color 140ms ease,box-shadow 140ms ease;border:0;background:var(--accent);color:var(--surface);box-shadow:0 1px 2px rgb(0 0 0 / .08);}.ds-primary:hover{background:var(--accent-strong);}.ds-primary:focus-visible{outline:none;box-shadow:inset 0 0 0 1px var(--surface);}.ds-primary:disabled{opacity:.4;}"
    },
    {
      "name": "次按钮",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "克制的边界与轻微下沉悬停。",
      "html": "<button class=\"ds-secondary\">取消</button>",
      "css": ".ds-secondary{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;font-size:12px;font-weight:500;min-height:32px;padding:6px 12px;border:1px solid var(--border);border-radius:var(--radius-control);background:var(--surface);color:var(--text);cursor:pointer;transition:background-color 140ms ease,color 140ms ease,box-shadow 140ms ease;}.ds-secondary:hover{background:var(--inset);border-color:var(--border-strong);}.ds-secondary:focus-visible{outline:none;box-shadow:inset 0 0 0 1px var(--focus);}.ds-secondary:disabled{opacity:.4;}"
    },
    {
      "name": "标准字段",
      "kind": "input",
      "refersTo": "field",
      "description": "字段静止为 inset，聚焦转为 surface 与 focus 细边界。",
      "html": "<label class=\"ds-field\">提醒时间<input aria-label=\"提醒时间\" placeholder=\"设置提醒时间\"/></label>",
      "css": ".ds-field{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;color:var(--text);display:grid;gap:6px;font-size:11px;color:var(--muted);}.ds-field input{font:inherit;font-size:13px;color:var(--text);padding:8px 10px;border:1px solid var(--border);border-radius:var(--radius-control);background:var(--inset);transition:border-color 140ms ease,background-color 140ms ease;}.ds-field input::placeholder{color:var(--quiet);opacity:1;}.ds-field input:focus-visible{outline:none;border-color:var(--focus);box-shadow:none;background:var(--surface);}"
    },
    {
      "name": "直接编辑任务与悬停操作",
      "kind": "custom",
      "refersTo": "task-row",
      "description": "37px 紧凑行；22px 层级缩进。操作显现后仍为灰色，悬停／聚焦显示语义色，确认删除保持绿色。",
      "html": "<div class=\"ds-task\" tabindex=\"0\"><button class=\"ds-check\" aria-label=\"完成任务\"></button><span class=\"ds-copy\">整理本周的阅读笔记</span><div class=\"ds-actions\"><button class=\"ds-edit\" aria-label=\"编辑任务\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m16 3 5 5-12 12-6 1 1-6Z M14 5l5 5\"/></svg></button><button class=\"ds-delete\" aria-label=\"删除任务\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 6h18M9 6V3h6v3M6 6l1 15h10l1-15M10 10v7M14 10v7\"/></svg></button></div></div>",
      "css": ".ds-task{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;color:var(--text);display:flex;align-items:flex-start;gap:5px;min-height:37px;padding:6px 4px;border-radius:6px;background:var(--surface);}.ds-task:hover{background:var(--inset);}.ds-task:focus-visible{outline:none;box-shadow:inset 0 0 0 1px var(--focus);}.ds-copy{flex:1;font-size:13px;line-height:23px;}.ds-check{width:16px;min-width:16px;height:16px;margin-top:4px;border:1px solid var(--border-strong);border-radius:4px;background:var(--surface);}.ds-check:focus-visible{outline:none;box-shadow:inset 0 0 0 1px var(--focus);}.ds-actions{display:flex;gap:1px;max-width:0;overflow:hidden;opacity:0;transform:translateX(9px);transition:max-width 200ms cubic-bezier(.16,1,.3,1),transform 200ms cubic-bezier(.16,1,.3,1),opacity 160ms ease;}.ds-task:hover .ds-actions,.ds-task:focus-within .ds-actions{max-width:182px;opacity:1;transform:translateX(0);}.ds-actions button{display:grid;place-items:center;width:23px;min-width:23px;height:25px;padding:5px;border:0;border-radius:5px;background:transparent;color:var(--icon);cursor:pointer;}.ds-actions button:is(:hover,:focus-visible){background:var(--surface);}.ds-edit:is(:hover,:focus-visible){color:var(--action-edit);}.ds-delete:is(:hover,:focus-visible){color:var(--action-delete);}.ds-actions button:focus-visible{outline:none;box-shadow:inset 0 0 0 1px var(--focus);}.ds-actions .ds-armed{color:var(--action-confirm);background:color-mix(in srgb,var(--action-confirm) 12%,transparent);}@media(prefers-reduced-motion:reduce){.ds-actions{transition:none;}}"
    },
    {
      "name": "任务详细设置",
      "kind": "custom",
      "refersTo": "task-settings-dialog",
      "description": "所属窗口内模态；文档标题透明无框，字段沿用下沉表面。静态示例仅展示视觉。",
      "html": "<section class=\"ds-editor\"><header>任务设置</header><div class=\"ds-editor-body\"><input class=\"ds-editor-title\" aria-label=\"任务标题\" value=\"阅读计划\"/><label class=\"ds-editor-label\">描述<textarea aria-label=\"描述\">记录阅读中的问题。</textarea></label></div><footer><button class=\"ds-editor-cancel\">取消</button><button class=\"ds-editor-save\">保存</button></footer></section>",
      "css": ".ds-editor{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;color:var(--text);width:min(460px,calc(100vw - 28px));border-radius:var(--radius-overlay);background:var(--surface);box-shadow:var(--shadow-dialog);overflow:hidden;}.ds-editor header{padding:12px 18px;border-bottom:1px solid var(--border-subtle);font-size:13px;font-weight:600;}.ds-editor-body{padding:18px;}.ds-editor .ds-editor-title{width:100%;font:inherit;font-size:18px;font-weight:550;line-height:1.5;letter-spacing:-.015em;padding:0;margin:0 0 20px;color:var(--text);background:transparent;border:0;border-radius:0;}.ds-editor-title:focus-visible{outline:none;box-shadow:none;}.ds-editor-label{display:grid;gap:6px;color:var(--muted);font-size:11px;font-weight:500;}.ds-editor textarea{font:inherit;font-size:13px;color:var(--text);padding:8px 10px;min-height:86px;resize:vertical;border:1px solid var(--border);border-radius:6px;background:var(--inset);}.ds-editor textarea:focus-visible{outline:none;border-color:var(--focus);background:var(--surface);}.ds-editor footer{display:flex;justify-content:flex-end;gap:8px;padding:12px 18px;border-top:1px solid var(--border-subtle);}.ds-editor footer button{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;font-size:12px;font-weight:500;min-height:32px;padding:6px 12px;border:1px solid var(--border);border-radius:var(--radius-control);background:var(--surface);color:var(--text);cursor:pointer;transition:background-color 140ms ease,color 140ms ease,box-shadow 140ms ease;}.ds-editor footer button:hover{background:var(--inset);}.ds-editor footer button:focus-visible{outline:none;box-shadow:inset 0 0 0 1px var(--focus);}.ds-editor footer .ds-editor-save{background:var(--accent);color:var(--surface);border:0;}.ds-editor footer .ds-editor-save:hover{background:var(--accent-strong);}.ds-editor footer .ds-editor-save:focus-visible{box-shadow:inset 0 0 0 1px var(--surface);}"
    },
    {
      "name": "日历任务条",
      "kind": "custom",
      "refersTo": "calendar-task",
      "description": "月／周与甘特共用主题蓝色；完成状态加删除线。",
      "html": "<div class=\"ds-calendar\"><button>准备产品讨论</button><button class=\"ds-complete\">已完成的任务</button></div>",
      "css": ".ds-calendar{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;color:var(--text);display:grid;gap:5px;width:180px;padding:8px;background:var(--surface);}.ds-calendar button{font:inherit;font-size:11px;line-height:23px;min-height:23px;padding:0 7px;border:0;border-radius:4px;background:var(--calendar-blue);color:#fff;text-align:left;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;cursor:grab;}.ds-calendar button:hover{background:var(--calendar-blue-hover);}.ds-calendar button:focus-visible{outline:none;box-shadow:inset 0 0 0 1px var(--focus);}.ds-calendar .ds-complete{background:var(--calendar-blue-done);text-decoration:line-through;}"
    },
    {
      "name": "日期任务抽屉",
      "kind": "custom",
      "refersTo": "day-drawer",
      "description": "右侧 340–420px 抽屉；打开时星期标签与七列网格同步让出其宽度。静态示例展示头部与当天任务。",
      "html": "<section class=\"ds-drawer\"><header><div><h2>11月1日</h2><small>当天任务</small></div><button aria-label=\"关闭日期抽屉\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m6 6 12 12M6 18 18 6\"/></svg></button></header><p>阅读计划</p></section>",
      "css": ".ds-drawer{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;color:var(--text);width:clamp(340px,40vw,420px);min-width:340px;background:var(--surface);box-shadow:-12px 0 36px rgb(20 20 24 / .1);}.ds-drawer header{display:flex;align-items:center;justify-content:space-between;padding:16px 18px;border-bottom:1px solid var(--border-subtle);background:var(--inset);}.ds-drawer h2{font-size:15px;font-weight:600;margin:0 0 4px;}.ds-drawer small{font-size:10px;color:var(--quiet);}.ds-drawer button{width:28px;height:28px;padding:6px;border:0;border-radius:6px;background:transparent;color:var(--icon);cursor:pointer;}.ds-drawer button:hover{background:var(--secondary);color:var(--text);}.ds-drawer button:focus-visible{outline:none;box-shadow:inset 0 0 0 1px var(--focus);}.ds-drawer p{font-size:13px;line-height:23px;margin:0;padding:14px 18px;}"
    },
    {
      "name": "任务标签选择",
      "kind": "chip",
      "refersTo": "tag-popover",
      "description": "标签使用保存颜色的实心色块与对比文字；顶层浮层避开裁切，按窗口空间翻转，选项独立滚动。",
      "html": "<section class=\"ds-tags\"><input aria-label=\"搜索或新增标签\" placeholder=\"搜索标签\"/><div class=\"ds-tag-options\"><label><input type=\"checkbox\" checked/><span class=\"ds-tag-chip\" style=\"--tag-color:#b93838;--tag-ink:#ffffff\">重要</span></label><label><input type=\"checkbox\"/><span class=\"ds-tag-chip\" style=\"--tag-color:#b45309;--tag-ink:#ffffff\">紧急</span></label></div></section>",
      "css": ".ds-tags{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;color:var(--text);width:240px;max-width:calc(100vw - 16px);max-height:360px;display:flex;flex-direction:column;gap:8px;overflow:hidden;padding:12px;border-radius:9px;background:var(--surface);box-shadow:var(--shadow-popover);font-size:12px;}.ds-tags>input{font:inherit;width:100%;border:0;background:transparent;color:inherit;padding:2px;}.ds-tags>input::placeholder{color:var(--quiet);opacity:1;}.ds-tags label{display:flex;align-items:center;gap:6px;min-height:30px;padding:4px 5px;border-radius:4px;}.ds-tags label:hover{background:var(--inset);}.ds-tags input[type=checkbox]{accent-color:var(--accent);width:15px;height:15px;}.ds-tags :focus-visible{outline:none;box-shadow:inset 0 0 0 1px var(--focus);}.ds-tag-options{min-height:0;overflow-y:auto;overscroll-behavior:contain;}.ds-tag-chip{display:inline-flex;max-width:100%;min-width:0;align-items:center;padding:1px 6px;border-radius:4px;background:var(--tag-color,#64748b);color:var(--tag-ink,#ffffff);font-size:10px;font-weight:500;line-height:17px;overflow-wrap:anywhere;white-space:normal;}"
    },
    {
      "name": "复盘侧栏导航",
      "kind": "nav",
      "refersTo": "review-navigation",
      "description": "chrome 侧栏与 surface 活动项；112px 宽，850px 以下 88px。",
      "html": "<nav class=\"ds-nav\" aria-label=\"复盘导航\"><button class=\"ds-current\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m3 10 9-7 9 7v10H3ZM9 20v-8h6v8\"/></svg>首页</button><button><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 3h14v18H4ZM1 7h6M1 12h6M1 17h6\"/></svg>复盘</button></nav>",
      "css": ".ds-nav{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;color:var(--text);display:flex;flex-direction:column;width:112px;padding:16px 8px;gap:4px;background:var(--chrome);border-right:1px solid var(--border-subtle);}.ds-nav button{font:inherit;font-size:12px;font-weight:450;display:flex;align-items:center;gap:8px;min-height:35px;padding:8px 10px;border:0;border-radius:6px;background:transparent;color:var(--muted);text-align:left;cursor:pointer;}.ds-nav button:hover{background:var(--hover);}.ds-nav .ds-current{background:var(--surface);color:var(--text);font-weight:550;box-shadow:0 1px 3px rgb(0 0 0 / .04);}.ds-nav button:focus-visible{outline:none;box-shadow:inset 0 0 0 1px var(--focus);}@media(max-width:850px){.ds-nav{width:88px;}}"
    },
    {
      "name": "NOTE 编辑器",
      "kind": "custom",
      "refersTo": "note-title",
      "description": "透明文档标题与 13px/1.8 Markdown 正文；保留实际保存、预览和确认流程。",
      "html": "<section class=\"ds-note\"><header>编辑笔记<button aria-label=\"保存笔记\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 3h15l3 3v15H3ZM7 3v6h10V3M7 21v-8h10v8\"/></svg></button></header><input aria-label=\"笔记标题\" value=\"本周复盘\"/><textarea aria-label=\"Markdown 笔记内容\">## 观察\n记录今天的收获。</textarea><small>未保存</small></section>",
      "css": ".ds-note{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;color:var(--text);display:flex;flex-direction:column;gap:14px;min-width:260px;padding-left:18px;background:var(--surface);}.ds-note header{display:flex;align-items:center;justify-content:space-between;font-size:13px;font-weight:600;}.ds-note button{width:28px;height:28px;padding:6px;background:transparent;color:var(--icon);border:0;border-radius:6px;cursor:pointer;}.ds-note button:hover{background:var(--secondary);color:var(--text);}.ds-note button:focus-visible{outline:none;box-shadow:inset 0 0 0 1px var(--focus);}.ds-note input,.ds-note textarea{font:inherit;color:inherit;background:transparent;border:0;border-radius:0;}.ds-note input{font-size:17px;font-weight:550;letter-spacing:-.015em;padding:6px 0;}.ds-note textarea{font-size:13px;line-height:1.8;min-height:270px;padding:8px 0;resize:vertical;}.ds-note input:focus-visible,.ds-note textarea:focus-visible{outline:none;box-shadow:none;}.ds-note small{font-size:10px;color:var(--quiet);}"
    }
  ],
  "narrative": {
    "northStar": "Quiet Neutral Workstation",
    "overview": "SimpleTodo 的界面把频繁勾选、拆分、改期与快速记录放在同一工作现场。近白与石墨表面、层次灰文字、系统字体和克制的细分隔线保持任务密度；顶栏品牌只保留 SimpleTodo 文字，不显示对钩或本地徽标。应用图标与关于页共用蓝底白色交叉双对钩，图标蓝色不扩展为全局强调色。任务操作图标默认灰色，悬停与键盘聚焦时显示语义色；输入星星、任务标签、日历与甘特任务条保留局部彩色反馈。\n\n这是 macOS 优先、兼顾 Windows 的 Wails 桌面工具。列表、日历、专注、设置、复盘各有可同时打开的独立工作窗口，保持同一紧凑工具语言；日计划与收集箱共用列表窗口。任务详情与确认属于当前工作窗口。任务按起止范围每天独立完成，标签帮助筛选，复盘用真实任务统计和本地 Markdown 笔记回看记录。任务、标签和笔记保存在本地；版本检查只访问固定发布来源。",
    "keyCharacteristics": [
      "黑白灰浅深主题配对，系统字体与 1.7px Lucide 线性图标；任务操作默认灰色、悬停／聚焦才显示语义色，输入星星、任务标签和日历／甘特任务条使用局部彩色反馈。",
      "五个独立工作窗口分别恢复位置、正常尺寸和最大化状态；任务详情与确认保留所属窗口上下文。",
      "37px 最小任务行、22px 层级缩进与稳定箭头列；单击原位编辑、加号草稿与独立详细设置。",
      "日期范围、每日完成历史、可选标签显示与带端点的甘特横条；复盘采用灰阶图表、任务报告与可调宽 NOTE 分栏。"
    ],
    "rules": [
      {
        "name": "The Scoped Color Rule",
        "body": "任务操作默认使用中性图标色，仅悬停／键盘聚焦显示语义色，等待删除确认保持绿色；其他彩色只服务短暂输入反馈、任务标签和日历／甘特任务条，统计沿用中性色。",
        "section": "colors"
      },
      {
        "name": "The Quiet Focus Rule",
        "body": "键盘焦点保持可见，以单层细内框或字段边界表达；不使用厚重外框。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 沿用前置 token 的浅深配对、系统字体和 1.7px Lucide 线性图标。",
      "Do 让任务操作默认灰色，悬停与键盘聚焦显示语义色，等待删除确认保持绿色。",
      "Do 保留根任务组单条分隔、37px 紧凑行和 22px 层级缩进。",
      "Do 在日期抽屉打开时为七列网格与星期标签让出相同宽度。",
      "Do 让普通列表与日历日期抽屉共享原位编辑、新增和键盘操作；独立任务设置按钮与日历网格任务条进入抽屉详情。",
      "Do 让 Enter 同级草稿显示在原任务全部可见后代之后，以原任务为 afterTask 保存；Shift+Tab 先保存标题再连同后代提升一级。",
      "Do 允许完成项编辑和键盘提升，标题保存保留完成状态；新增未完成子项只将其祖先恢复未完成，保留其他完成子项。",
      "Do 让月/周日期格内符合当前过滤的已加载根任务独立滚动，溢出时显示持久轨道；蓝白任务条用于日历与甘特，甘特复用日历蓝色 token。",
      "Do 让新建、同级和子任务复用原位草稿；子草稿按完成项置底顺序插在已完成直接子任务前，取消不改状态，保护输入法和冲突草稿。",
      "Do 允许每层节点多选，按完整分支预览和提交、父子去重，并让 Esc 在选择框和搜索聚焦时退出多选。",
      "Do 使用同窗组件确认、默认取消与焦点返回；键盘焦点使用灰色细内框，保留选中填色。",
      "Do 使用自定义 combobox/listbox，展开定位当前选中项，保留键盘选择、禁用状态与焦点返回。",
      "Do 以开始和可选结束时间表达跨度，每天独立完成并保留历史；月／周子任务默认关闭，日历／甘特默认隐藏已完成并独立于清单记忆偏好。",
      "Do 让日计划与收集箱分别记忆完成与标签过滤，标签显示默认关闭，同级排序保留计划日期。",
      "Do 用蓝色细线与小圆点投影插入位置和层级，完整分支参与五层限制；完成项置底时线条与提交均停在未完成同级区末尾。",
      "Do 保存每个节点的展开与折叠，在重进和重启后恢复；点击层级入口或调整深度按当前 snapshot 重置，滑条保持 1—5 层、默认 2 层。",
      "Do 让日期拖滑固定选中槽位并在结束时吸附，有脏编辑时不启动；星期标签居中对齐月/周日期列。",
      "Do 将本机日程与任务分开只读显示，说明系统账户、经典 Outlook 和新版 Outlook 的读取边界；保留缓存及错误反馈。",
      "Do 用组件弹窗说明自动发现的新版本、立即更新与跳过此版本，保留手动检查、安装进度和失败恢复入口。",
      "Do 保持复盘真实灰阶统计、可调报告／NOTE 分栏和必填笔记标题，删除先确认，失败保留草稿。",
      "Do 同时检查紧凑列表、复盘分栏、日历／甘特、深色与减少动画。"
    ],
    "donts": [
      "Don't 把应用图标蓝色推广为主题强调色，或恢复品牌对钩、本地徽标与底部存储说明。",
      "Don't 恢复任务更多菜单、分支聚焦、面包屑或移到收集箱入口；删除使用行内两次确认。",
      "Don't 把独立工作窗口重新合并为单窗口；任务详情、提示与确认保留所属窗口内 HTML 组件。",
      "Don't 恢复永久新增输入框或专用常驻子输入，或把所有任务强制多行排版；仅选中项完整换行。",
      "Don't 恢复黑色外焦点框或应用原生确认窗口；系统文件和日期选择器保留。",
      "Don't 把日期任务再次排在日历下面，或把详细设置恢复为行下展开。",
      "Don't 把浏览器截图、窗口配置检查或跨平台编译写成原生 GUI 验收通过，或把窗口截图写成桌面合成透明效果的证明。"
    ]
  }
}
