{
  "name": "simpletodo",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "vue-tsc && vite build --minify false --mode development",
    "build": "vue-tsc && vite build --mode production",
    "preview": "vite preview",
    "dev:site": "vite --config vite.site.config.ts",
    "build:site": "vue-tsc --noEmit -p tsconfig.site.json && vite build --config vite.site.config.ts",
    "preview:site": "vite preview --config vite.site.config.ts --host 127.0.0.1 --port 9255",
    "test:site": "playwright test --config playwright.site.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@wailsio/runtime": "3.0.0-beta.33",
    "lucide-vue-next": "^0.577.0",
    "markdown-it": "^15.0.3",
    "motion": "^14.6.0",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.3.3",
    "vue": "^3.2.45"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/markdown-it": "^14.2.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.5.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^8.0.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.12"
  }
}
